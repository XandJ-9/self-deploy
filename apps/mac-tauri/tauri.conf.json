{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SelfDeploy",
  "version": "1.0.1",
  "identifier": "com.selfdeploy.mac",
  "build": {
    "beforeDevCommand": "npm run dev:renderer",
    "beforeBuildCommand": "npm run build:renderer",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../dist/renderer"
  },
  "app": {
    "windows": [
      {
        "title": "SelfDeploy",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "shortDescription": "本地项目快速部署到服务器的桌面工具",
    "longDescription": "SelfDeploy 使用 Git 增量识别变更，并通过 SFTP/FTP 将本地项目同步到目标服务器。"
  }
}
