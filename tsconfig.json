{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@domain/*": ["packages/domain/src/*"],
      "@ipc-contract/*": ["packages/ipc-contract/src/*"],
      "@platform-adapter/*": ["packages/platform-adapter/src/*"],
      "@renderer/*": ["apps/shared-renderer/src/*"],
      "@main/*": ["apps/mac-electron/src/main/*"]
    }
  }
}
